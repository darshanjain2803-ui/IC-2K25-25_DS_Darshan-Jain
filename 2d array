#include <iostream>
using namespace std;

int main() {
    int numbers[2][3];

    cout << "Enter 6 numbers:" << endl;

    // Taking input
    for (int i = 0; i < 2; i++) {
        for (int j = 0; j < 3; j++) {
            cin >> numbers[i][j];
        }
    }

    // Displaying the array
    cout << "Your 2D array is:" << endl;

    for (int i = 0; i < 2; i++) {
        for (int j = 0; j < 3; j++) {
            cout << numbers[i][j] << " ";
        }
        cout << endl;
    }

    return 0;
}
