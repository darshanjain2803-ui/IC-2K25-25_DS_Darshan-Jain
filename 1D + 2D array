#include <iostream>
using namespace std;

int main() {

    // 1D Array
    int arr1[3];

    cout << "Enter 3 numbers for 1D array:" << endl;

    for (int i = 0; i < 3; i++) {
        cin >> arr1[i];
    }

    cout << "1D Array:" << endl;

    for (int i = 0; i < 3; i++) {
        cout << arr1[i] << " ";
    }

    cout << endl << endl;


    // 2D Array
    int arr2[2][3];

    cout << "Enter 6 numbers for 2D array:" << endl;

    for (int i = 0; i < 2; i++) {
        for (int j = 0; j < 3; j++) {
            cin >> arr2[i][j];
        }
    }

    cout << "2D Array:" << endl;

    for (int i = 0; i < 2; i++) {
        for (int j = 0; j < 3; j++) {
            cout << arr2[i][j] << " ";
        }
        cout << endl;
    }

    return 0;
}
